{
  "name": "@cheetcode-solutions/v3",
  "version": "3.0.0",
  "description": "CheetCode V3 solver, contract preflight, and offline rehearsal harness",
  "private": true,
  "license": "MIT",
  "type": "module",
  "scripts": {
    "install:browsers": "playwright install chromium",
    "full:headful": "HEADED=1 LEVEL3_UI_USE_REGISTERED=1 LEVEL3_UI_PRESTART_RETRIES=20 tsx src/full-headful-runner.ts",
    "level1:headful": "HEADED=1 FULL_HEADFUL_LEVELS=1 tsx src/full-headful-runner.ts",
    "level1": "tsx src/level1-runner.ts",
    "level1:offline-check": "tsx src/level1-offline-check.ts",
    "level1:llm": "LEVEL1_USE_LLM=1 tsx src/level1-runner.ts",
    "level2": "tsx src/level2-runner.ts run",
    "level2:speed-demon": "LEVEL2_SPEED_DEMON=1 tsx src/level2-runner.ts run",
    "level2:preview": "tsx src/level2-runner.ts preview",
    "level3": "LEVEL3_USE_REGISTERED=1 LEVEL3_SKELETON_HOLES=1 tsx src/level3-runner.ts run",
    "level3:speed-demon": "LEVEL3_SPEED_DEMON=1 tsx src/level3-runner.ts run",
    "level3:catalog": "tsx src/level3-runner.ts catalog",
    "level3:candidates:check": "tsx src/level3-candidates-check.ts",
    "level3:components:preflight": "tsx src/level3-component-preflight.ts",
    "level3:offline": "tsx src/level3-offline-runner.ts",
    "level3:preview": "tsx src/level3-runner.ts preview",
    "local:rehearsal": "tsx scripts/local-rehearsal.ts",
    "recon": "tsx src/recon.ts",
    "v3:preflight": "tsx src/ctf-v3-preflight.ts",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "level1:fingerprint": "tsx src/level1-fingerprint.ts"
  },
  "engines": {
    "node": "^22.12.0 || >=24.0.0"
  },
  "dependencies": {
    "playwright": "^1.57.0"
  },
  "devDependencies": {
    "@types/node": "^25.0.0",
    "tsx": "^4.21.0",
    "typescript": "^5.9.0",
    "vitest": "^4.0.0"
  }
}
